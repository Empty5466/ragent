{
  "version": "campus-eval-v1",
  "description": "校园服务域端到端评测集：kb=知识库检索题(doc+关键词), tool=意图工具路由题, negative=不应触发校园工具题",
  "cases": [
    { "id": "lib-01", "type": "kb", "question": "书没看完怎么续借？", "expected_doc": "图书馆借阅规则", "expected_keywords": ["续借"] },
    { "id": "lib-02", "type": "kb", "question": "本科生一次最多能借几本书？", "expected_doc": "图书馆借阅规则", "expected_keywords": ["10"] },
